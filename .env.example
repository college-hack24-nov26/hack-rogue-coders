# Copy to .env only when .env does not already exist.
# Keep real credentials in .env; leave secret values blank in this example.
# This file configures the server/worker. Never use EXPO_PUBLIC_ for secrets.

# Application and database (use the Neon connection URL for production).
DATABASE_URL=sqlite:///./jalsathi.db
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:8081

# Optional Redis cache for village directory reads. Leave blank to query the database directly.
REDIS_URL=
REDIS_DIRECTORY_TTL_SECONDS=60

# Authentication. Generate private random signing/encryption keys locally.
AUTH_MODE=local
LOCAL_SIGNING_KEY=
SESSION_ENCRYPTION_KEY=
NEON_AUTH_URL=
NEON_AUTH_JWKS_URL=
NEON_AUTH_ISSUER=
NEON_AUTH_AUDIENCE=
NEON_AUTH_ORIGIN=http://localhost:5173

# Private photo storage. Select s3 after configuring the private bucket.
STORAGE_MODE=local
PRIVATE_STORAGE_ROOT=./.private
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Gemini explanations (server-side credentials only).
GEMINI_API_KEY=
GEMINI_MODEL=

# WhatsApp Business. Select the API version supported by your Meta app.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
ALLOW_EXTERNAL_SEND=false
WHATSAPP_STATUS_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_TEMPLATE_APPROVED=false

# Optional market feed and background processing.
AGMARKNET_API_KEY=
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
ENABLE_DAILY_INGESTION=false
MODEL_ARTIFACT_ROOT=./artifacts
RETENTION_DAYS=365
