# Copy to .env only when .env does not already exist.
# Keep real credentials in .env; REPLACE_WITH_ values are inactive placeholders.
# Run python -m scripts.prepare_whatsapp to generate local keys safely.
# This file configures the server/worker. Never use EXPO_PUBLIC_ for secrets.

# Application and database (use the Neon connection URL for production).
DATABASE_URL=sqlite:///./jalsathi.db
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:8081

# Authentication. Generate private random signing/encryption keys locally.
AUTH_MODE=local
LOCAL_SIGNING_KEY=
SESSION_ENCRYPTION_KEY=
NEON_AUTH_URL=
NEON_AUTH_JWKS_URL=
NEON_AUTH_ISSUER=
NEON_AUTH_AUDIENCE=
NEON_AUTH_ORIGIN=http://localhost:5173

# Private photo storage. Select s3 after configuring the private bucket.
STORAGE_MODE=local
PRIVATE_STORAGE_ROOT=./.private
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Gemini explanations (server-side credentials only).
GEMINI_API_KEY=
GEMINI_MODEL=

# Meta app Settings -> Basic -> App secret.
WHATSAPP_APP_SECRET=REPLACE_WITH_META_APP_SECRET
# Generate locally; must match the verification token entered in Meta webhook setup.
WHATSAPP_VERIFY_TOKEN=REPLACE_WITH_LOCAL_RANDOM_VERIFY_TOKEN
# WhatsApp API Setup / API Testing -> access token for the test business number.
WHATSAPP_ACCESS_TOKEN=REPLACE_WITH_META_ACCESS_TOKEN
# Use Phone number ID, not the displayed phone number or business account ID.
WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_META_PHONE_NUMBER_ID
# Select the supported Graph version shown by your Meta app, including its v prefix.
WHATSAPP_API_VERSION=REPLACE_WITH_META_GRAPH_API_VERSION
# Callback is HTTPS tunnel origin + /api/v1/webhooks/whatsapp; no callback env var is used.
# No outbound messages until explicitly authorised.
ALLOW_EXTERNAL_SEND=false
# Comma-separated Meta-approved test recipients, digits with country code.
WHATSAPP_APPROVED_RECIPIENTS=REPLACE_WITH_META_APPROVED_TEST_RECIPIENTS
# Optional within the 24-hour window. Required outside it, with opt-in and real approval.
WHATSAPP_STATUS_TEMPLATE=REPLACE_WITH_META_APPROVED_STATUS_TEMPLATE
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_TEMPLATE_APPROVED=false

# Optional market feed and background processing.
AGMARKNET_API_KEY=
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
ENABLE_DAILY_INGESTION=false
MODEL_ARTIFACT_ROOT=./artifacts
RETENTION_DAYS=365
